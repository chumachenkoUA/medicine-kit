// ✅ ПРАВИЛЬНО
generator client {
  provider = "prisma-client-js"  // <--- Тільки так!
  previewFeatures = ["driverAdapters"] // Це треба для вашого prisma.ts
}

datasource db {
  provider = "postgresql"
}

model tabletos {
  Id          BigInt    @id @default(autoincrement())
  Name        String    @db.VarChar(2044)
  Description String?   @db.VarChar(2044)
  Effects     String?   @db.VarChar(2044)
  Format      String    @db.VarChar(2044)
  Link        String    @unique @db.VarChar(2044)
  Photo       String?   @db.VarChar(2044)
  Quantity    Int
  Rate        Int?      @db.SmallInt
  
  courses     courses[] 
  tabletos_user  tabletos_user[]
}

model users {
  Id       BigInt    @id @default(autoincrement())
  Email    String    @unique @db.VarChar(2044)
  Name     String    @db.VarChar(2044)
  Password String    @db.VarChar(2044)
  Surname  String    @db.VarChar(2044)
  Username String    @db.VarChar(2044)
  
  courses  courses[]
  tabletos_user  tabletos_user[] 
  course_dose_logs course_dose_logs[]
}

model courses {
  Id             BigInt @id @default(autoincrement())
  Name_doctor    String @db.VarChar(2044)
  Period_courses Int    @db.SmallInt
  Start_date     DateTime @default(now()) @db.Date
  Quantity_day   Int    @db.SmallInt
  Status         String @default("planned") @db.VarChar(32)
  Dose_times     Json?
  Description   String? @db.VarChar(2044)

  users_id    BigInt
  tabletos_id BigInt

  users    users    @relation(fields: [users_id], references: [Id], onDelete: Cascade, map: "fk_users")
  tabletos tabletos @relation(fields: [tabletos_id], references: [Id], onDelete: Cascade, map: "fk_tabletos")
  course_dose_logs course_dose_logs[]
}

model tabletos_user{
  Id              BigInt @id @default(autoincrement())
  tabletos_id     BigInt
  Count           Int
  Expiration_date DateTime @db.Date
  Create_date     DateTime @db.Date
  users_id        BigInt

  users    users    @relation(fields: [users_id], references: [Id], onDelete: Cascade, map: "fk_users")
  tabletos tabletos @relation(fields: [tabletos_id], references: [Id], onDelete: Cascade, map: "fk_tabletos")
  course_dose_logs course_dose_logs[]
  }

model course_dose_logs {
  Id         BigInt   @id @default(autoincrement())
  course_id  BigInt
  users_id   BigInt
  tabletos_user_id BigInt?
  Dose_date  DateTime @db.Date
  Dose_time  String   @db.VarChar(5)
  State      String   @db.VarChar(32)
  Created_at DateTime @default(now())
  Updated_at DateTime @updatedAt

  course courses @relation(fields: [course_id], references: [Id], onDelete: Cascade, map: "fk_course_dose_logs_course")
  users  users   @relation(fields: [users_id], references: [Id], onDelete: Cascade, map: "fk_course_dose_logs_user")
  tabletos_user tabletos_user? @relation(fields: [tabletos_user_id], references: [Id], onDelete: SetNull, map: "fk_course_dose_logs_tabletos_user")

  @@unique([course_id, Dose_date, Dose_time])
  @@index([users_id, Dose_date])
  @@index([tabletos_user_id])
}
