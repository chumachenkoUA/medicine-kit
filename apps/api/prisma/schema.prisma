// ✅ ПРАВИЛЬНО
generator client {
  provider = "prisma-client-js"  // <--- Тільки так!
  previewFeatures = ["driverAdapters"] // Це треба для вашого prisma.ts
}

datasource db {
  provider = "postgresql"
}

model tabletos {
  Id          BigInt    @id @default(autoincrement())
  Name        String    @db.VarChar(2044)
  Description String?   @db.VarChar(2044)
  Effects     String?   @db.VarChar(2044)
  Format      String    @db.VarChar(2044)
  Link        String    @unique @db.VarChar(2044)
  Photo       String?   @db.VarChar(2044)
  Quantity    Int
  Rate        Int?      @db.SmallInt
  
  courses     courses[] 
  tabletos_user  tabletos_user[]
}

model users {
  Id       BigInt    @id @default(autoincrement())
  Email    String    @unique @db.VarChar(2044)
  Name     String    @db.VarChar(2044)
  Password String    @db.VarChar(2044)
  Surname  String    @db.VarChar(2044)
  Username String    @db.VarChar(2044)
  
  courses  courses[]
  tabletos_user  tabletos_user[] 
}

model courses {
  Id             BigInt @id @default(autoincrement())
  Name_doctor    String @db.VarChar(2044)
  Period_courses Int    @db.SmallInt
  Quantity_day   Int    @db.SmallInt
  Quantity_week  Int    @db.SmallInt
  Description   String? @db.VarChar(2044)

  users_id    BigInt
  tabletos_id BigInt

  users    users    @relation(fields: [users_id], references: [Id], onDelete: Cascade, map: "fk_users")
  tabletos tabletos @relation(fields: [tabletos_id], references: [Id], onDelete: Cascade, map: "fk_tabletos")
}

model tabletos_user{
  Id              BigInt @id @default(autoincrement())
  tabletos_id     BigInt
  Count           Int
  Expiration_date DateTime @db.Date
  Create_date     DateTime @db.Date
  users_id        BigInt

  users    users    @relation(fields: [users_id], references: [Id], onDelete: Cascade, map: "fk_users")
  tabletos tabletos @relation(fields: [tabletos_id], references: [Id], onDelete: Cascade, map: "fk_tabletos")
  }
